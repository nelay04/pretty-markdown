// Release log for Pretty Markdown, written by the "prepare-release" prompt
// (.github/prompts/prepare-release.prompt.md).
//
// The newest release is the LAST object in the array, and its "releaseName" is
// the line under which everything is settled: only CHANGELOG versions above it
// are ever offered as a new release, whether an older one was folded in or
// skipped entirely.
//
// "dated" is Asia/Kolkata time, taken verbatim from:
//   node -e "console.log(new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }).format(new Date()).replace(/[,\s]+/g, '-'))"
//
// The release note itself is NOT stored here. A JSON string cannot hold a real
// line break, so any note kept in this file — escaped with \n, or split into an
// array of lines — arrives in GitHub's release body carrying \n escapes or
// quotes and commas. Each note therefore lives in its own Markdown file under
// notes/, named for the version, and "releaseNoteFile" points at it. That file
// IS the release body: open it, select all, paste into GitHub, publish.
//
// Releases made before this log existed are only in CHANGELOG.md, so the first
// run of the prompt offers every version in it — select just the ones going out.
//
// {
//   "releaseName": "1.7.0",
//   "dated": "13-Aug-2026-01:47-am",
//   "releaseTitle": "Release v1.7.0",
//   "releaseNoteFile": "notes/v1.7.0.md"
// }
[
  {
    "releaseName": "1.5.0",
    "dated": "12-Aug-2026-02:48-pm",
    "releaseTitle": "Release v1.5.0",
    "releaseNoteFile": "notes/v1.5.0.md"
  },
  {
    "releaseName": "1.6.0",
    "dated": "13-Aug-2026-02:23-am",
    "releaseTitle": "Release v1.6.0",
    "releaseNoteFile": "notes/v1.6.0.md"
  },
  {
    "releaseName": "1.7.0",
    "dated": "15-Aug-2026-07:09-pm",
    "releaseTitle": "Release v1.7.0",
    "releaseNoteFile": "notes/v1.7.0.md"
  },
  {
    "releaseName": "1.8.0",
    "dated": "16-Aug-2026-01:35-am",
    "releaseTitle": "Release v1.8.0",
    "releaseNoteFile": "notes/v1.8.0.md"
  }
]

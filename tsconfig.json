{
	"compilerOptions": {
		/* esbuild bundles this project, not tsc: describing the modules as ESM
		   is what lets an ESM-only dependency (@puppeteer/browsers) be imported
		   without tsc objecting to a require() call it will never emit. */
		"module": "ES2022",
		"moduleResolution": "Node",
		"esModuleInterop": true,
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"skipLibCheck": true,
		/* Only these are needed as ambient types. Without this, every package
		   under node_modules/@types is auto-included, which drags in mermaid's
		   @types/d3-* — written for a newer compiler than this project uses. */
		"types": [
			"node",
			"vscode",
			"mocha"
		],
		/* Additional Checks */
		// "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
		// "noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */
	}
}

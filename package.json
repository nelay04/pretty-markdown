{
  "name": "pretty-markdown",
  "displayName": "Pretty Markdown",
  "description": "Beautiful Markdown preview and PDF export with syntax highlighting",
  "version": "1.4.0",
  "publisher": "mistx",
  "author": {
    "name": "Snowy",
    "email": "snowflake.2k04@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nelay04/pretty-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nelay04/pretty-markdown/issues"
  },
  "homepage": "https://github.com/nelay04/pretty-markdown",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "media/icon-transparent-vscode.png",
  "galleryBanner": {
    "color": "#569cd6",
    "theme": "dark"
  },
  "categories": [
    "Formatters",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "pdf",
    "export",
    "syntax highlighting",
    "documentation",
    "pretty",
    "beautiful",
    "styling"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:pretty-markdown.preview",
    "onCommand:pretty-markdown.exportPDF",
    "onCommand:pretty-markdown.refreshFiles",
    "onCommand:pretty-markdown.searchFiles",
    "onCommand:pretty-markdown.showFilterInfo",
    "onCommand:pretty-markdown.runAction",
    "onCommand:pretty-markdown.toggleActionConfirmation",
    "onCommand:pretty-markdown.openSettings",
    "onCommand:pretty-markdown.toggleActionPause",
    "onCommand:pretty-markdown.stopAction",
    "onCommand:pretty-markdown.restartAction",
    "onView:prettyMarkdownView"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prettyMarkdown",
          "title": "Pretty Markdown",
          "icon": "media/icon-transparent-vscode.png"
        }
      ]
    },
    "views": {
      "prettyMarkdown": [
        {
          "id": "prettyMarkdownView",
          "name": "Pretty Markdown"
        }
      ]
    },
    "commands": [
      {
        "command": "pretty-markdown.preview",
        "title": "Preview",
        "category": "Pretty Markdown",
        "icon": "$(eye)"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "title": "Export PDF",
        "category": "Pretty Markdown",
        "icon": "$(download)"
      },
      {
        "command": "pretty-markdown.refreshFiles",
        "title": "Refresh Markdown Files",
        "category": "Pretty Markdown",
        "icon": "$(refresh)"
      },
      {
        "command": "pretty-markdown.searchFiles",
        "title": "Search Markdown Files",
        "category": "Pretty Markdown",
        "icon": "$(search)"
      },
      {
        "command": "pretty-markdown.showFilterInfo",
        "title": "Show Filter Details",
        "category": "Pretty Markdown",
        "icon": "$(filter)"
      },
      {
        "command": "pretty-markdown.runAction",
        "title": "Run Action",
        "category": "Pretty Markdown",
        "icon": "$(play)"
      },
      {
        "command": "pretty-markdown.toggleActionPause",
        "title": "Pause or Resume Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pretty-markdown.stopAction",
        "title": "Stop Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pretty-markdown.restartAction",
        "title": "Restart Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pretty-markdown.toggleActionConfirmation",
        "title": "Toggle Ask Confirmation Before Action",
        "category": "Pretty Markdown",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pretty-markdown.openSettings",
        "title": "Settings",
        "category": "Pretty Markdown",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "pretty-markdown.preview",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorLangId == markdown"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pretty-markdown.openSettings",
          "when": "view == prettyMarkdownView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pretty-markdown.showFilterInfo",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup && prettyMarkdownFilterActive",
          "group": "inline@1"
        },
        {
          "command": "pretty-markdown.searchFiles",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup",
          "group": "inline@2"
        },
        {
          "command": "pretty-markdown.refreshFiles",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup",
          "group": "inline@3"
        },
        {
          "command": "pretty-markdown.preview",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownActive",
          "group": "inline"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownActive",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        }
      ],
      "commandPalette": [
        {
          "command": "pretty-markdown.preview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "editorLangId == markdown"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "compile": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-build": "node esbuild.js --production",
    "test": "vscode-test",
    "pretest": "npm run compile && npm run lint",
    "fix": "eslint src --fix",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.13.2",
    "highlight.js": "^11.7.0",
    "html2pdf.js": "^0.14.0",
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^21.11.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.0",
    "tar-fs": "^3.1.1",
    "ws": "^8.21.0"
  }
}

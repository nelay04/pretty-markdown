{
  "name": "pretty-markdown",
  "displayName": "Pretty Markdown",
  "description": "Beautiful Markdown preview and PDF export with syntax highlighting",
  "version": "1.2.0",
  "publisher": "mistx",
  "author": {
    "name": "Snowy",
    "email": "snowflake.2k04@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nelay04/pretty-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nelay04/pretty-markdown/issues"
  },
  "homepage": "https://github.com/nelay04/pretty-markdown",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "media/icon-transparent.png",
  "galleryBanner": {
    "color": "#569cd6",
    "theme": "dark"
  },
  "categories": [
    "Formatters",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "pdf",
    "export",
    "syntax highlighting",
    "documentation",
    "pretty",
    "beautiful",
    "styling"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pretty-markdown.preview",
        "title": "Preview",
        "category": "Pretty Markdown",
        "icon": "$(eye)"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "title": "Export PDF",
        "category": "Pretty Markdown",
        "icon": "$(download)"
      }
    ],
    "keybindings": [
      {
        "command": "pretty-markdown.preview",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorLangId == markdown"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        }
      ],
      "commandPalette": [
        {
          "command": "pretty-markdown.preview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "editorLangId == markdown"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "compile": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-build": "node esbuild.js --production",
    "test": "vscode-test",
    "pretest": "npm run compile && npm run lint",
    "fix": "eslint src --fix",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.1.1",
    "html2pdf.js": "^0.10.1",
    "highlight.js": "^11.7.0",
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^21.11.0"
  }
}

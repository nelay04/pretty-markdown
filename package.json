{
  "name": "pretty-markdown",
  "displayName": "Pretty Markdown",
  "description": "Beautiful Markdown preview and PDF export with syntax highlighting",
  "version": "1.8.0",
  "publisher": "mistx",
  "author": {
    "name": "Snowy",
    "email": "snowflake.2k04@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nelay04/pretty-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/nelay04/pretty-markdown/issues"
  },
  "homepage": "https://github.com/nelay04/pretty-markdown",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "media/icon-transparent-vscode.png",
  "galleryBanner": {
    "color": "#569cd6",
    "theme": "dark"
  },
  "categories": [
    "Formatters",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "pdf",
    "export",
    "syntax highlighting",
    "documentation",
    "pretty",
    "beautiful",
    "styling"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:pretty-markdown.preview",
    "onCommand:pretty-markdown.closePreview",
    "onCommand:pretty-markdown.exportPDF",
    "onCommand:pretty-markdown.refreshFiles",
    "onCommand:pretty-markdown.searchFiles",
    "onCommand:pretty-markdown.showFilterInfo",
    "onCommand:pretty-markdown.runAction",
    "onCommand:pretty-markdown.toggleActionConfirmation",
    "onCommand:pretty-markdown.openSettings",
    "onCommand:pretty-markdown.toggleActionPause",
    "onCommand:pretty-markdown.stopAction",
    "onCommand:pretty-markdown.restartAction",
    "onView:prettyMarkdownView"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prettyMarkdown",
          "title": "Pretty Markdown",
          "icon": "media/icon-transparent-vscode.png"
        }
      ]
    },
    "views": {
      "prettyMarkdown": [
        {
          "id": "prettyMarkdownView",
          "name": "Pretty Markdown"
        }
      ]
    },
    "commands": [
      {
        "command": "pretty-markdown.preview",
        "title": "Preview",
        "category": "Pretty Markdown",
        "icon": "$(eye)"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "title": "Export PDF",
        "category": "Pretty Markdown",
        "icon": "$(download)"
      },
      {
        "command": "pretty-markdown.refreshFiles",
        "title": "Refresh Markdown Files",
        "category": "Pretty Markdown",
        "icon": "$(refresh)"
      },
      {
        "command": "pretty-markdown.searchFiles",
        "title": "Search Markdown Files",
        "category": "Pretty Markdown",
        "icon": "$(search)"
      },
      {
        "command": "pretty-markdown.showFilterInfo",
        "title": "Show Filter Details",
        "category": "Pretty Markdown",
        "icon": "$(filter)"
      },
      {
        "command": "pretty-markdown.runAction",
        "title": "Run Action",
        "category": "Pretty Markdown",
        "icon": "$(play)"
      },
      {
        "command": "pretty-markdown.toggleActionPause",
        "title": "Pause or Resume Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pretty-markdown.stopAction",
        "title": "Stop Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pretty-markdown.restartAction",
        "title": "Restart Action",
        "category": "Pretty Markdown",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pretty-markdown.toggleActionConfirmation",
        "title": "Toggle Ask Confirmation Before Action",
        "category": "Pretty Markdown",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pretty-markdown.closePreview",
        "title": "Close Preview",
        "category": "Pretty Markdown",
        "icon": "$(eye-closed)"
      },
      {
        "command": "pretty-markdown.openSettings",
        "title": "Settings",
        "category": "Pretty Markdown",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "pretty-markdown.preview",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorLangId == markdown"
      },
      {
        "command": "pretty-markdown.exportPDF",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pretty-markdown.openSettings",
          "when": "view == prettyMarkdownView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "pretty-markdown.showFilterInfo",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup && prettyMarkdownFilterActive",
          "group": "inline@1"
        },
        {
          "command": "pretty-markdown.searchFiles",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup",
          "group": "inline@2"
        },
        {
          "command": "pretty-markdown.refreshFiles",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownGroup",
          "group": "inline@3"
        },
        {
          "command": "pretty-markdown.preview",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownActive",
          "group": "inline"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "view == prettyMarkdownView && viewItem == prettyMarkdownActive",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "pretty-markdown.closePreview",
          "when": "activeWebviewPanelId == prettyMarkdownPreview",
          "group": "navigation"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "pretty-markdown.preview",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "resourceExtname == .md",
          "group": "pretty-markdown"
        }
      ],
      "commandPalette": [
        {
          "command": "pretty-markdown.preview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "pretty-markdown.closePreview",
          "when": "activeWebviewPanelId == prettyMarkdownPreview"
        },
        {
          "command": "pretty-markdown.exportPDF",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Pretty Markdown",
      "properties": {
        "prettyMarkdown.theme": {
          "type": "string",
          "enum": [
            "default",
            "github",
            "dark",
            "sepia"
          ],
          "enumItemLabels": [
            "Pretty Light",
            "GitHub",
            "Pretty Dark",
            "Sepia"
          ],
          "enumDescriptions": [
            "Pretty Light - the original Pretty Markdown palette",
            "GitHub - light palette close to GitHub rendered Markdown",
            "Pretty Dark - dark palette suited to dark editors",
            "Sepia - warm, low-contrast palette for long reading"
          ],
          "default": "default",
          "markdownDescription": "Colour theme for the preview and exported PDFs. Individual components can be overridden with `#prettyMarkdown.colors#`."
        },
        "prettyMarkdown.colors": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "string",
              "description": "Page background. Any CSS colour, e.g. #1a1a1a."
            },
            "text": {
              "type": "string",
              "description": "Body text. Any CSS colour, e.g. #1a1a1a."
            },
            "heading": {
              "type": "string",
              "description": "Heading text. Any CSS colour, e.g. #1a1a1a."
            },
            "headingRule": {
              "type": "string",
              "description": "Rule under the top-level heading. Any CSS colour, e.g. #1a1a1a."
            },
            "link": {
              "type": "string",
              "description": "Link text. Any CSS colour, e.g. #1a1a1a."
            },
            "linkHover": {
              "type": "string",
              "description": "Link text on hover. Any CSS colour, e.g. #1a1a1a."
            },
            "inlineCodeBackground": {
              "type": "string",
              "description": "Inline `code` background. Any CSS colour, e.g. #1a1a1a."
            },
            "inlineCodeText": {
              "type": "string",
              "description": "Inline `code` text. Any CSS colour, e.g. #1a1a1a."
            },
            "codeBackground": {
              "type": "string",
              "description": "Code block background. Any CSS colour, e.g. #1a1a1a."
            },
            "codeText": {
              "type": "string",
              "description": "Code block text. Any CSS colour, e.g. #1a1a1a."
            },
            "codeBorder": {
              "type": "string",
              "description": "Code block border. Any CSS colour, e.g. #1a1a1a."
            },
            "blockquoteBackground": {
              "type": "string",
              "description": "Blockquote background. Any CSS colour, e.g. #1a1a1a."
            },
            "blockquoteBorder": {
              "type": "string",
              "description": "Blockquote left border. Any CSS colour, e.g. #1a1a1a."
            },
            "blockquoteText": {
              "type": "string",
              "description": "Blockquote text. Any CSS colour, e.g. #1a1a1a."
            },
            "tableBackground": {
              "type": "string",
              "description": "Table background. Any CSS colour, e.g. #1a1a1a."
            },
            "tableHeaderBackground": {
              "type": "string",
              "description": "Table header background. Any CSS colour, e.g. #1a1a1a."
            },
            "tableRowAlternate": {
              "type": "string",
              "description": "Alternating table row background. Any CSS colour, e.g. #1a1a1a."
            },
            "tableBorder": {
              "type": "string",
              "description": "Table borders. Any CSS colour, e.g. #1a1a1a."
            },
            "horizontalRule": {
              "type": "string",
              "description": "Horizontal rule. Any CSS colour, e.g. #1a1a1a."
            },
            "diagramBackground": {
              "type": "string",
              "description": "Mermaid diagram background. Any CSS colour, e.g. #1a1a1a."
            },
            "markBackground": {
              "type": "string",
              "description": "Background behind ==highlighted== text. Any CSS colour, e.g. #1a1a1a."
            },
            "markText": {
              "type": "string",
              "description": "Text colour of ==highlighted== text. Any CSS colour, e.g. #1a1a1a."
            },
            "alertNote": {
              "type": "string",
              "description": "Accent for a > [!NOTE] alert. Any CSS colour, e.g. #1a1a1a."
            },
            "alertTip": {
              "type": "string",
              "description": "Accent for a > [!TIP] alert. Any CSS colour, e.g. #1a1a1a."
            },
            "alertImportant": {
              "type": "string",
              "description": "Accent for a > [!IMPORTANT] alert. Any CSS colour, e.g. #1a1a1a."
            },
            "alertWarning": {
              "type": "string",
              "description": "Accent for a > [!WARNING] alert. Any CSS colour, e.g. #1a1a1a."
            },
            "alertCaution": {
              "type": "string",
              "description": "Accent for a > [!CAUTION] alert. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxKeyword": {
              "type": "string",
              "description": "Syntax: keywords. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxString": {
              "type": "string",
              "description": "Syntax: strings. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxComment": {
              "type": "string",
              "description": "Syntax: comments. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxNumber": {
              "type": "string",
              "description": "Syntax: numbers. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxBuiltIn": {
              "type": "string",
              "description": "Syntax: built-ins. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxVariable": {
              "type": "string",
              "description": "Syntax: variables. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxTitle": {
              "type": "string",
              "description": "Syntax: titles. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxAttribute": {
              "type": "string",
              "description": "Syntax: attributes. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxLiteral": {
              "type": "string",
              "description": "Syntax: literals. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxFunction": {
              "type": "string",
              "description": "Syntax: functions. Any CSS colour, e.g. #1a1a1a."
            },
            "syntaxPunctuation": {
              "type": "string",
              "description": "Syntax: punctuation. Any CSS colour, e.g. #1a1a1a."
            }
          },
          "markdownDescription": "Per-component colour overrides applied on top of `#prettyMarkdown.theme#`. Values that are not valid CSS colours are ignored."
        },
        "prettyMarkdown.oversizedDiagrams": {
          "type": "string",
          "enum": [
            "ask",
            "keepWhole",
            "split"
          ],
          "enumDescriptions": [
            "Ask during export, once it is known which diagrams are affected",
            "Scale the diagram so it prints whole, leaving the space before it blank",
            "Print the diagram across the page break so no space is wasted"
          ],
          "default": "ask",
          "markdownDescription": "What to do when a diagram or image is too tall to fit in the space left on the page of an exported PDF."
        },
        "prettyMarkdown.exportTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "markdownDescription": "Seconds a PDF export may spend laying the document out before it gives up. Raise it for a long or image-heavy document that fails with a timeout; set it to `0` to wait for as long as it takes."
        },
        "prettyMarkdown.diagramTimeout": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "markdownDescription": "Seconds a PDF export waits for the diagrams in a document to be drawn. A diagram that is not ready in time is printed as its source text, so the export still finishes. Set it to `0` to wait for as long as it takes."
        },
        "prettyMarkdown.openPreviewIn": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "replace"
          ],
          "enumItemLabels": [
            "New editor group",
            "Current editor group",
            "Replace the file's editor"
          ],
          "enumDescriptions": [
            "Open the preview in a new editor group beside the Markdown file",
            "Open the preview as a tab in the editor group the Markdown file is in",
            "Open the preview in the file's place, closing the file's editor. Close Preview puts the file back"
          ],
          "default": "beside",
          "markdownDescription": "Where the preview opens."
        }
      }
    }
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "vscode:prepublish": "npm run package-build",
    "compile": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-build": "node esbuild.js --production",
    "test": "vscode-test",
    "pretest": "npm run compile && npm run lint",
    "fix": "eslint src --fix",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.7.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "puppeteer-core": "^21.11.0"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.0",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.0",
    "tar-fs": "^3.1.1",
    "ws": "^8.21.0"
  }
}
